	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["node", "mocha", "@wdio/globals/types", "wdio-obsidian-service", "@wdio/mocha-framework"]
	},
	"include": ["wdio.conf.mts", "test/**/*.ts"]
}
